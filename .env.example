# Copiez ce fichier en ".env" puis remplissez les valeurs.

PORT=3000

# PostgreSQL en local (voir README.md)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=barbier
# Chez un hébergeur, une seule ligne suffit à la place : DATABASE_URL=postgres://utilisateur:motdepasse@hote:5432/base

# Numéro WhatsApp du propriétaire, format international avec +
OWNER_WHATSAPP=+2250700000000

# Fournisseur : callmebot (gratuit, recommandé), twilio, ou vide pour afficher le message dans la console
WHATSAPP_PROVIDER=callmebot

# CallMeBot : clé reçue après activation (voir README.md)
CALLMEBOT_APIKEY=

# Twilio (seulement si WHATSAPP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+14155238886

# Mot de passe pour consulter la liste des réservations via GET /api/reservations
ADMIN_TOKEN=changez-moi
